# Local Node 22+ development; no secrets are required.
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=0
STORAGE_MODE=memory
PVP_ALLOWED=1
ALLOWED_ORIGINS=https://istanbuloyun.netlify.app,https://istanbulgame.netlify.app
# On Render: HOST=0.0.0.0, TRUST_PROXY=1. Render supplies PORT.
# For a CrazyGames-hosted build append the EXACT origin of the game iframe.
# The parent portal origin is not the game's network Origin.
# No DATA_DIR on Render Free: online progress is temporary in RAM.
